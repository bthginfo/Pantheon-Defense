{
  "name": "pantheon-defense",
  "private": true,
  "version": "6.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "art": "blender -b -t 4 --python-exit-code 1 --python art/arenas.py && blender -b -t 4 --python-exit-code 1 --python art/cast.py && blender -b -t 4 --python-exit-code 1 --python art/fortifications.py && npm run art:mobile",
    "art:mobile": "node art/mobile.mjs && npm run art:poses",
    "art:poses": "node art/pose-cache.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@vercel/blob": "^2.9.0",
    "pg": "^8.16.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.3.0",
    "@gltf-transform/extensions": "4.3.0",
    "@playwright/test": "^1.56.1",
    "gl-matrix": "3.4.4",
    "https-proxy-agent": "^9.1.0",
    "meshoptimizer": "1.3.0",
    "vite": "^7.1.12"
  }
}
